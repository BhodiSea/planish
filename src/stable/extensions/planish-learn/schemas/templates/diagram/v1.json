{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:cogveralabs.ai,2026:planish/templates/diagram/v1",
  "title": "Diagram",
  "description": "The learner reads a diagram of the code, drawn from Mermaid text.",
  "type": "object",
  "properties": {
    "template": {
      "const": "tag:cogveralabs.ai,2026:planish/templates/diagram/v1",
      "description": "This template and major version."
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "description": "A short title the learner sees."
    },
    "after": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "description": "Ids of earlier parts the learner should finish first."
    },
    "mermaid": {
      "type": "string",
      "description": "The diagram in Mermaid: a flowchart, sequence, class, state or entity-relationship diagram, without click actions or init directives."
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "description": "Optional; claims the diagram makes, with the lines that bear them out.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "One assertion about the code."
          },
          "cite": {
            "$ref": "#/$defs/cite"
          }
        },
        "required": [
          "text",
          "cite"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "template",
    "id",
    "title",
    "mermaid"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "description": "Lowercase letters, digits and hyphens, starting with a letter; unique in the lesson."
    },
    "file": {
      "type": "string",
      "description": "A path relative to the project's root, with forward slashes."
    },
    "cite": {
      "type": "object",
      "description": "The lines of code that bear this out.",
      "properties": {
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "type": "integer",
          "description": "The first line, counted from 1."
        },
        "endLine": {
          "type": "integer",
          "description": "The last line, inclusive."
        }
      },
      "required": [
        "file",
        "line",
        "endLine"
      ],
      "additionalProperties": false
    }
  }
}
