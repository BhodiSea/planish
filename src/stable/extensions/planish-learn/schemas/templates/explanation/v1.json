{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:cogveralabs.ai,2026:planish/templates/explanation/v1",
  "title": "Explanation with a question",
  "description": "The learner reads an explanation beside the code, then answers a question on it.",
  "type": "object",
  "properties": {
    "template": {
      "const": "tag:cogveralabs.ai,2026:planish/templates/explanation/v1",
      "description": "This template and major version."
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "description": "A short title the learner sees."
    },
    "after": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "description": "Ids of earlier parts the learner should finish first."
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "description": "Each claim the part makes about the code, with the lines that bear it out.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "One assertion about the code."
          },
          "cite": {
            "$ref": "#/$defs/cite"
          }
        },
        "required": [
          "text",
          "cite"
        ],
        "additionalProperties": false
      }
    },
    "diagram": {
      "$ref": "#/$defs/id",
      "description": "Optional; the id of a diagram part shown beside the explanation."
    },
    "question": {
      "type": "object",
      "description": "The question the explanation ends with.",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "The question, as the learner sees it."
        },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Each point a good answer makes, to be marked yes or no."
        }
      },
      "required": [
        "prompt",
        "rubric"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "template",
    "id",
    "title",
    "claims",
    "question"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "description": "Lowercase letters, digits and hyphens, starting with a letter; unique in the lesson."
    },
    "file": {
      "type": "string",
      "description": "A path relative to the project's root, with forward slashes."
    },
    "cite": {
      "type": "object",
      "description": "The lines of code that bear this out.",
      "properties": {
        "file": {
          "$ref": "#/$defs/file"
        },
        "line": {
          "type": "integer",
          "description": "The first line, counted from 1."
        },
        "endLine": {
          "type": "integer",
          "description": "The last line, inclusive."
        }
      },
      "required": [
        "file",
        "line",
        "endLine"
      ],
      "additionalProperties": false
    }
  }
}
