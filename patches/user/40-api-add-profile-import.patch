--- /dev/null
+++ b/src/vscode-dts/vscode.proposed.planishProfileImport.d.ts
@@ -0,0 +1,41 @@
+// --- Start Planish ---
+// SPDX-License-Identifier: Apache-2.0
+
+declare module 'vscode' {
+
+	/**
+	 * What a profile holds, as the text of the files VS Code keeps for it.
+	 */
+	export interface PlanishProfileData {
+		/** The text of settings.json. */
+		readonly settings?: string;
+		/** The text of keybindings.json. */
+		readonly keybindings?: string;
+		/** The text of tasks.json. */
+		readonly tasks?: string;
+		/** The text of each snippets file, by file name. */
+		readonly snippets?: { readonly [name: string]: string };
+		/** The extensions to install from the gallery, by ID. */
+		readonly extensions?: readonly string[];
+	}
+
+	export namespace env {
+		/**
+		 * Replaces the current profile's settings, keyboard shortcuts, tasks and snippets with
+		 * those given, keeping its machine-specific settings, as VS Code's profile import does,
+		 * and installs the extensions beside those it has, once the user trusts their publishers.
+		 *
+		 * @returns The IDs of the extensions that were not installed.
+		 */
+		export function importIntoProfile(data: PlanishProfileData): Thenable<string[]>;
+
+		/**
+		 * Creates a profile from the data and installs its extensions from the gallery. The user
+		 * is asked to trust their publishers, and before a profile of that name is replaced.
+		 *
+		 * @returns Whether the profile was created.
+		 */
+		export function createProfile(name: string, data: PlanishProfileData): Thenable<boolean>;
+	}
+}
+// --- End Planish ---
