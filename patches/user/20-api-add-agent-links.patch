+// --- Start Planish ---
+// SPDX-License-Identifier: Apache-2.0
+
+declare module 'vscode' {
+
+	export namespace env {
+		/**
+		 * Opens a link to Claude Code or Codex in the product's own URL scheme, such as
+		 * `planish://anthropic.claude-code/open?prompt=…`, without asking the user whether that
+		 * extension may open it. Rejects any other link.
+		 *
+		 * @returns Whether the link was handled.
+		 */
+		export function openAgentLink(uri: Uri): Thenable<boolean>;
+	}
+}
